Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RTABMap_Optimized_Cloud1
        - /Live_RGBD_Cloud1
        - /Graph_Trajectory_And_Historical_Tags1
        - /Robot_base_link1
        - /AprilTag_Current1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 100; 100; 100
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RTABMap_Optimized_Cloud
      Topic:
        Value: /cloud_map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Position Transformer: XYZ
      Use rainbow: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Diagnostic_Live_RGBD_Cloud
      Topic:
        Value: /rtabmap/frame_cloud
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Position Transformer: XYZ
      Use rainbow: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Diagnostic_Odometry_Local_Map
      Topic:
        Value: /odom_local_map
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Color Transformer: FlatColor
      Color: 255; 80; 80
      Style: Points
      Size (Pixels): 3
      Decay Time: 1
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Diagnostic_Raw_MapPath_Including_Landmarks
      Topic:
        Value: /mapPath
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Line Style: Lines
      Line Width: 0.03
      Color: 0; 255; 0
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Graph_Trajectory_And_Historical_Tags
      Topic:
        Value: /mapping/graph_display
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Name: Robot_base_link
      Reference Frame: base_link
      Length: 0.15
      Radius: 0.01
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: AprilTag_Current
      Topic:
        Value: /apriltag/markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: AprilTag_Registered_History_From_Receipts
      Topic:
        Value: /wbrov/tags/main_markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Diagnostic_AprilTag_Map_Cached
      Topic:
        Value: /apriltag/map_markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/PoseArray
      Enabled: false
      Name: Diagnostic_Raw_Landmark_Axes
      Topic:
        Value: /landmarks
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Shape: Axes
      Axes Length: 0.12
      Axes Radius: 0.01
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Live_RGB_20Hz
      Topic:
        Value: /zed/rgb/image_rect_color
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Normalize Range: true
      Min Value: 0
      Max Value: 1
      Median window: 5
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Last_Trusted_View_Return_Reference
      Topic:
        Value: /wbrov/mapping/recovery_reference_image
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Normalize Range: true
      Min Value: 0
      Max Value: 1
      Median window: 5
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Mapping_Continuity_Status
      Topic:
        Value: /mapping/continuity_display
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: Diagnostic_All_TF_Frames
      Frame Timeout: 15
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
  Global Options:
    Background Color: 25; 25; 30
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4
      Pitch: 0.55
      Yaw: 0.785
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
Window Geometry:
  Height: 850
  Width: 1300
